#include "utils/async_if_test_helper.hxx"

#include "openlcb/ConfiguredFlashingConsumer.hxx"
#include "openlcb/ConfigUpdateFlow.hxx"
#include "os/MmapGpio.hxx"

#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>

namespace openlcb
{

static const uint64_t kEventSteady = 0x05010101FFFF0000ULL;
static const uint64_t kEventFlashing = 0x05010101FFFF0001ULL;
static const uint64_t kEventOff = 0x05010101FFFF0002ULL;

/// Test fixture for ConfiguredFlashingConsumer.
class ConfiguredFlashingConsumerTest : public AsyncNodeTest
{
protected:
    ConfiguredFlashingConsumerTest()
    {
    }

    ~ConfiguredFlashingConsumerTest()
    {
        wait_for_event_thread();
        if (fd_ >= 0)
        {
            ::close(fd_);
        }
        unlink(tempFile_);
    }

    /// Creates a temporary config file and initializes the consumer.
    /// @param on_period flash on-time in 33Hz ticks (default 3 for fast
    /// tests).
    /// @param off_period flash off-time in 33Hz ticks (default 3 for fast
    /// tests).
    void create_consumer(uint8_t on_period = 3, uint8_t off_period = 3)
    {
        fd_ = mkstemp(tempFile_);
        ASSERT_GE(fd_, 0);

        // FlashingConsumerConfig layout:
        //   8 bytes description (StringConfigEntry<8>)
        //   8 bytes event_steady (EventConfigEntry, big-endian)
        //   8 bytes event_flashing (EventConfigEntry, big-endian)
        //   8 bytes event_off (EventConfigEntry, big-endian)
        //   1 byte on_period (Uint8ConfigEntry)
        //   1 byte off_period (Uint8ConfigEntry)
        // Total: 34 bytes.

        uint8_t buf[34];
        memset(buf, 0, sizeof(buf));

        // event_steady at offset 8.
        uint64_t ev_steady = htobe64(kEventSteady);
        memcpy(buf + 8, &ev_steady, 8);
        // event_flashing at offset 16.
        uint64_t ev_flashing = htobe64(kEventFlashing);
        memcpy(buf + 16, &ev_flashing, 8);
        // event_off at offset 24.
        uint64_t ev_off = htobe64(kEventOff);
        memcpy(buf + 24, &ev_off, 8);
        // on_period at offset 32.
        buf[32] = on_period;
        // off_period at offset 33.
        buf[33] = off_period;

        ASSERT_EQ((ssize_t)sizeof(buf), ::write(fd_, buf, sizeof(buf)));
        ::lseek(fd_, 0, SEEK_SET);

        updateFlow_.TEST_set_fd(fd_);

        consumer_.reset(
            new ConfiguredFlashingConsumer(node_, cfg_, &pin0_));

        wait_for_main_executor();
        wait_for_event_thread();
    }

    /// Calls poll_33hz on the consumer the specified number of times.
    /// @param count number of poll cycles to run.
    void run_poll_cycles(unsigned count)
    {
        for (unsigned i = 0; i < count; ++i)
        {
            SyncNotifiable n;
            consumer_->poll_33hz(&helper_, &n);
            n.wait_for_notification();
        }
    }

    /// GPIO storage.
    uint32_t gpioStorage_{0};

    /// Output pin backed by the storage word.
    MmapGpio pin0_{&gpioStorage_, 0, true};

    /// Configuration entry at offset 0.
    FlashingConsumerConfig cfg_{0};

    /// Config update flow.
    ConfigUpdateFlow updateFlow_{ifCan_.get()};

    /// WriteHelper for polling.
    WriteHelper helper_;

    /// The consumer under test.
    std::unique_ptr<ConfiguredFlashingConsumer> consumer_;

    int fd_{-1};
    char tempFile_[40] = "/tmp/flash_test_XXXXXX";
};

TEST_F(ConfiguredFlashingConsumerTest, CreateDestroy)
{
    create_consumer();
}

TEST_F(ConfiguredFlashingConsumerTest, InitiallyOff)
{
    create_consumer();
    EXPECT_FALSE(pin0_.is_set());
    EXPECT_FALSE(consumer_->is_flashing());
    EXPECT_FALSE(consumer_->is_steady());
}

// --- Steady-on tests ---

TEST_F(ConfiguredFlashingConsumerTest, SteadyOnTurnsOutputOn)
{
    create_consumer();

    send_packet(":X195B4001N05010101FFFF0000;");
    wait_for_event_thread();

    EXPECT_TRUE(pin0_.is_set());
    EXPECT_TRUE(consumer_->is_steady());
    EXPECT_FALSE(consumer_->is_flashing());
}

TEST_F(ConfiguredFlashingConsumerTest, SteadyOnNotAffectedByPolling)
{
    create_consumer();

    send_packet(":X195B4001N05010101FFFF0000;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());

    // Run many poll cycles -- pin should stay high.
    run_poll_cycles(50);
    EXPECT_TRUE(pin0_.is_set());
    EXPECT_TRUE(consumer_->is_steady());
}

// --- Flashing tests ---

TEST_F(ConfiguredFlashingConsumerTest, FlashingStartsWithPinHigh)
{
    create_consumer();

    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();

    EXPECT_TRUE(pin0_.is_set());
    EXPECT_TRUE(consumer_->is_flashing());
    EXPECT_FALSE(consumer_->is_steady());
}

TEST_F(ConfiguredFlashingConsumerTest, FlashingTogglesPin)
{
    // on_period=3, off_period=3 (symmetric).
    create_consumer(3, 3);

    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());

    // Ticks 1-3: remaining counts down from 3 to 0. Pin stays high.
    run_poll_cycles(3);
    EXPECT_TRUE(pin0_.is_set());

    // Tick 4: remaining was 0, toggle to low, reload remaining = off_period.
    run_poll_cycles(1);
    EXPECT_FALSE(pin0_.is_set());

    // Ticks 5-7: remaining counts down. Pin stays low.
    run_poll_cycles(3);
    EXPECT_FALSE(pin0_.is_set());

    // Tick 8: toggle to high, reload remaining = on_period.
    run_poll_cycles(1);
    EXPECT_TRUE(pin0_.is_set());
}

TEST_F(ConfiguredFlashingConsumerTest, AsymmetricDutyCycle)
{
    // on_period=2, off_period=5 (short on, long off).
    create_consumer(2, 5);

    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());

    // Ticks 1-2: remaining counts down from 2. Pin stays high.
    run_poll_cycles(2);
    EXPECT_TRUE(pin0_.is_set());

    // Tick 3: toggle to low. remaining reloads to off_period=5.
    run_poll_cycles(1);
    EXPECT_FALSE(pin0_.is_set());

    // Ticks 4-8: remaining counts down from 5. Pin stays low.
    run_poll_cycles(5);
    EXPECT_FALSE(pin0_.is_set());

    // Tick 9: toggle to high. remaining reloads to on_period=2.
    run_poll_cycles(1);
    EXPECT_TRUE(pin0_.is_set());

    // Ticks 10-11: remaining counts down. Pin stays high.
    run_poll_cycles(2);
    EXPECT_TRUE(pin0_.is_set());

    // Tick 12: toggle to low again.
    run_poll_cycles(1);
    EXPECT_FALSE(pin0_.is_set());
}

TEST_F(ConfiguredFlashingConsumerTest, PeriodOfOne)
{
    // Fastest flash: toggles every other tick.
    create_consumer(1, 1);

    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());

    // Tick 1: remaining goes 1 -> 0. Still high.
    run_poll_cycles(1);
    EXPECT_TRUE(pin0_.is_set());

    // Tick 2: remaining was 0, toggle to low.
    run_poll_cycles(1);
    EXPECT_FALSE(pin0_.is_set());

    // Tick 3: remaining goes 1 -> 0. Still low.
    run_poll_cycles(1);
    EXPECT_FALSE(pin0_.is_set());

    // Tick 4: toggle to high.
    run_poll_cycles(1);
    EXPECT_TRUE(pin0_.is_set());
}

// --- Off tests ---

TEST_F(ConfiguredFlashingConsumerTest, OffFromSteady)
{
    create_consumer();

    // Steady on.
    send_packet(":X195B4001N05010101FFFF0000;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());

    // Off.
    send_packet(":X195B4001N05010101FFFF0002;");
    wait_for_event_thread();
    EXPECT_FALSE(pin0_.is_set());
    EXPECT_FALSE(consumer_->is_steady());
    EXPECT_FALSE(consumer_->is_flashing());
}

TEST_F(ConfiguredFlashingConsumerTest, OffFromFlashing)
{
    create_consumer();

    // Start flashing.
    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    EXPECT_TRUE(consumer_->is_flashing());

    // Off.
    send_packet(":X195B4001N05010101FFFF0002;");
    wait_for_event_thread();
    EXPECT_FALSE(pin0_.is_set());
    EXPECT_FALSE(consumer_->is_flashing());

    // Further polling should be no-op.
    run_poll_cycles(20);
    EXPECT_FALSE(pin0_.is_set());
}

// --- State transition tests ---

TEST_F(ConfiguredFlashingConsumerTest, SteadyToFlashing)
{
    create_consumer(3, 3);

    // Steady on.
    send_packet(":X195B4001N05010101FFFF0000;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());
    EXPECT_TRUE(consumer_->is_steady());

    // Switch to flashing.
    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());
    EXPECT_TRUE(consumer_->is_flashing());

    // Should toggle after period+1 ticks.
    run_poll_cycles(3);
    EXPECT_TRUE(pin0_.is_set());
    run_poll_cycles(1);
    EXPECT_FALSE(pin0_.is_set());
}

TEST_F(ConfiguredFlashingConsumerTest, FlashingToSteady)
{
    create_consumer(3, 3);

    // Start flashing.
    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());

    // Let it toggle to low.
    run_poll_cycles(4);
    EXPECT_FALSE(pin0_.is_set());

    // Switch to steady -- pin should go high immediately.
    send_packet(":X195B4001N05010101FFFF0000;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());
    EXPECT_TRUE(consumer_->is_steady());

    // Polling should not toggle.
    run_poll_cycles(20);
    EXPECT_TRUE(pin0_.is_set());
}

TEST_F(ConfiguredFlashingConsumerTest, OffToFlashing)
{
    create_consumer(3, 3);

    // Explicit off.
    send_packet(":X195B4001N05010101FFFF0002;");
    wait_for_event_thread();
    EXPECT_FALSE(pin0_.is_set());

    // Start flashing.
    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    EXPECT_TRUE(pin0_.is_set());
    EXPECT_TRUE(consumer_->is_flashing());
}

// --- Unrelated event ---

TEST_F(ConfiguredFlashingConsumerTest, UnrelatedEventIgnored)
{
    create_consumer();

    send_packet(":X195B4001N05010101FFFF00FF;");
    wait_for_event_thread();
    EXPECT_FALSE(pin0_.is_set());
    EXPECT_FALSE(consumer_->is_flashing());
    EXPECT_FALSE(consumer_->is_steady());
}

// --- Identify tests ---

TEST_F(ConfiguredFlashingConsumerTest, IdentifyConsumerInitiallyOff)
{
    create_consumer();

    // Initially off: event_off = VALID, event_steady = INVALID,
    // event_flashing = INVALID.
    send_packet_and_expect_response(":X198F4001N05010101FFFF0002;",
        ":X194C422AN05010101FFFF0002;");
    send_packet_and_expect_response(":X198F4001N05010101FFFF0000;",
        ":X194C522AN05010101FFFF0000;");
    send_packet_and_expect_response(":X198F4001N05010101FFFF0001;",
        ":X194C522AN05010101FFFF0001;");
}

TEST_F(ConfiguredFlashingConsumerTest, IdentifyConsumerSteady)
{
    create_consumer();

    send_packet(":X195B4001N05010101FFFF0000;");
    wait_for_event_thread();
    Mock::VerifyAndClear(&canBus_);

    // Steady: event_steady = VALID, others INVALID.
    send_packet_and_expect_response(":X198F4001N05010101FFFF0000;",
        ":X194C422AN05010101FFFF0000;");
    send_packet_and_expect_response(":X198F4001N05010101FFFF0001;",
        ":X194C522AN05010101FFFF0001;");
    send_packet_and_expect_response(":X198F4001N05010101FFFF0002;",
        ":X194C522AN05010101FFFF0002;");
}

TEST_F(ConfiguredFlashingConsumerTest, IdentifyConsumerFlashing)
{
    create_consumer();

    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    Mock::VerifyAndClear(&canBus_);

    // Flashing: event_flashing = VALID, others INVALID.
    send_packet_and_expect_response(":X198F4001N05010101FFFF0001;",
        ":X194C422AN05010101FFFF0001;");
    send_packet_and_expect_response(":X198F4001N05010101FFFF0000;",
        ":X194C522AN05010101FFFF0000;");
    send_packet_and_expect_response(":X198F4001N05010101FFFF0002;",
        ":X194C522AN05010101FFFF0002;");
}

TEST_F(ConfiguredFlashingConsumerTest, GlobalIdentifyOff)
{
    create_consumer();

    // Initially off.
    expect_packet(":X194C522AN05010101FFFF0000;"); // steady INVALID
    expect_packet(":X194C522AN05010101FFFF0001;"); // flashing INVALID
    expect_packet(":X194C422AN05010101FFFF0002;"); // off VALID
    send_packet(":X19970001N;");
    wait_for_event_thread();
    Mock::VerifyAndClear(&canBus_);
}

TEST_F(ConfiguredFlashingConsumerTest, GlobalIdentifySteady)
{
    create_consumer();

    send_packet(":X195B4001N05010101FFFF0000;");
    wait_for_event_thread();
    Mock::VerifyAndClear(&canBus_);

    expect_packet(":X194C422AN05010101FFFF0000;"); // steady VALID
    expect_packet(":X194C522AN05010101FFFF0001;"); // flashing INVALID
    expect_packet(":X194C522AN05010101FFFF0002;"); // off INVALID
    send_packet(":X19970001N;");
    wait_for_event_thread();
    Mock::VerifyAndClear(&canBus_);
}

TEST_F(ConfiguredFlashingConsumerTest, GlobalIdentifyFlashing)
{
    create_consumer();

    send_packet(":X195B4001N05010101FFFF0001;");
    wait_for_event_thread();
    Mock::VerifyAndClear(&canBus_);

    expect_packet(":X194C522AN05010101FFFF0000;"); // steady INVALID
    expect_packet(":X194C422AN05010101FFFF0001;"); // flashing VALID
    expect_packet(":X194C522AN05010101FFFF0002;"); // off INVALID
    send_packet(":X19970001N;");
    wait_for_event_thread();
    Mock::VerifyAndClear(&canBus_);
}

} // namespace openlcb
